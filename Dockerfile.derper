FROM golang:1.26-alpine AS builder
# GitHub runners repeatedly hit HTTP/2 INTERNAL_ERROR while downloading Go modules.
# This affects build-time downloads only; TLS and module checksums remain enabled.
ENV GODEBUG=http2client=0
ARG TAILSCALE_VERSION
# Alpine disables automatic toolchain selection by default. Follow the pinned
# Tailscale module's minimum Go version when it exceeds the bundled compiler.
ENV GOTOOLCHAIN=auto
RUN test -n "${TAILSCALE_VERSION}" && apk add --no-cache ca-certificates git && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
      go install -trimpath -ldflags='-s -w' \
      "tailscale.com/cmd/derper@${TAILSCALE_VERSION}"

FROM alpine:3.22 AS runtime
RUN apk add --no-cache ca-certificates curl jq tzdata && \
    adduser -D -u 10001 derper && \
    install -d -o derper -g derper /app /app/certs
COPY --from=builder /go/bin/derper /app/derper
USER derper
ENTRYPOINT ["/app/derper"]

FROM runtime AS test
USER root
RUN /app/derper --help >/dev/null
